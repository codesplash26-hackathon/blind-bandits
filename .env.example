# This is an example .env file for bk. Copy this file to .env and fill in the values.
DATABASE_URL=connection string
JWT_SECRET_KEY=secret key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SUSTAINABILITY_WEIGHTS=replace-with-reviewed-versioned-json-configuration
PRESSURE_MODEL_ARTIFACT_DIR=artifacts/visitor_pressure
PRESSURE_BAND_THRESHOLDS=replace-with-reviewed-json-low_max-and-medium_max
SIMULATION_POLICY=replace-with-reviewed-versioned-json-policy
# Environmental ingestion. Open-Meteo needs no key for the default public endpoint.
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_API_KEY=only-for-a-configured-commercial-customer-endpoint
OPENAQ_URL=https://api.openaq.org/v3
# OPENAQ_API_KEY=set-this-in-your-private-environment
OPENAQ_RADIUS_M=25000
ENVIRONMENT_STALE_AFTER_MINUTES=180
ENVIRONMENT_HTTP_TIMEOUT_SECONDS=10

#
